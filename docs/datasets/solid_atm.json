  "assumptions": [
    {
      "key": "bass2_air_display",
      "text": "Air/Fan display bir hız değil cihaz potansiyometre okuması; çoğu hücre test boyunca ayar dizisi ('5 3 2 ext'). air_display_initial = ilk sayı; birim unit_unknown."
    },
    {
      "key": "bass2_co_censor",
      "text": "BASS-II CO 'OR'/'over'/'>500' = ölçüm aralığı aşıldı (sağdan sansürlü) -> NaN + *_overrange=True. 'none' -> NaN."
    },
    {
      "key": "bass2_material",
      "text": "BASS-II 'Fuel Sample Material' serbest metin -> material (PMMA/SIBAL/Nomex/Wax candle), geometry (film/slab/rod/fabric/sphere_section/candle), thickness_mm (micron/mm/inç'ten). Çubuklarda 'thickness' = çap. '4 cm spherical section' PMMA VARSAYILDI. SIBAL'de '2 cm' genişliktir, kalınlık NaN."
    },
    {
      "key": "bass2_negative_co",
      "text": "Negatif CO değerleri DÜZELTİLMEDİ; co_negative_flag ile işaretlendi (sensör ofseti olası)."
    },
    {
      "key": "bass2_o2_anomaly",
      "text": "o2_final_anomaly_flag: final O2 < %10 ya da O2'nin test boyunca >0.5 puan ARTMASI (fiziksel değil) -> işaretlendi, düzeltilmedi."
    }
  ],
  "notes": [
    "Negatif CO değerleri düzeltilmedi; co_final_ppm hedefinin alt kümesi co_negative_flag satırlarını dışarıda bırakır.",
    "d_o2_pct alt kümesi O2 anomalisi işaretli satırları dışarıda bırakır (filtre sütunları sette yok).",
    "PI (araştırmacı) ve malzeme iç içe; CV grubu pi."
  ]
