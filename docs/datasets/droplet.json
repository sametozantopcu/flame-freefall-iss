      "true": 241,
      "false": 27,
      "na": 233
    }
  ],
  "assumptions": [
    {
      "key": "cfi_has_cool",
      "text": "has_cool_flame = kcool ölçülmüş mü (1/0) - türetilmiş ikili hedef adayı; kcool analizi yapılmamış testlerde de 0 olabileceği için 'completed_analysis' ile birlikte yorumlanmalı."
    },
    {
      "key": "cfi_hf_burn",
      "text": "'hf burn time' sütununun birimi belirtilmemiş; değer aralığına göre saniye VARSAYILDI (hf = hot flame)."
    },
    {
      "key": "cfi_merge",
      "text": "PSI-39 cfi = Master_Sheet ⋈ DATA ⋈ Igniter (flex number, 1:1). Experimental_table (87) Master'ın alt kümesi; in_experimental_table ile işaretlendi."
    },
    {
      "key": "flex_K_d2",
      "text": "K_from_d2_law = (d0² - d_ext²)/t_b yalnızca bilgi amaçlı türetildi; hedef K ile sızıntı ilişkisi var (hedef olarak kullanılamaz)."
    },
    {
      "key": "flex_approx",
      "text": "FLEX 'Burn time' içindeki '~6', '~9' -> 6, 9 sayısal + burn_time_approx=True. '–' -> NaN."
    },
    {
      "key": "flex_burn_rate_unit",
      "text": "PSI-69 'Burning rate; mm' başlığındaki birim eksik; değer aralığı (~0.4-1 ) damlacık yanma sabiti K ile uyumlu -> burn_rate_K_mm2_s (mm²/s) VARSAYILDI."
    }
  ],
  "notes": [
    "FLEX ve CFI hedefleri birleştirilmedi: FLEX burn_rate_K_mm2_s ile CFI k_hot_mm2_s ayrı sütunlar (yakıtlar kesişmiyor, tanımlar farklı); birleştirmek bir modelleme kararıdır.",
    "CFI'de x_co2 ölçülmemiş/raporlanmamış: boş bırakıldı, 0 değildir.",
    "FLEX year 50 testte kaynakta boş; doldurulmadı (CV anahtarı fuel × diluent)."
  ]
